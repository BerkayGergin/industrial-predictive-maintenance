# Local-only development configuration.
# Copy this file to .env and set POSTGRES_PASSWORD before starting the stack.
# Never commit the generated .env file.

POSTGRES_DB=predictive
POSTGRES_USER=predictive
POSTGRES_PASSWORD=
POSTGRES_HOST_PORT=5433

MOTOR_ID=Motor_01
OPCUA_NAMESPACE_URI=urn:factory:predictive-maintenance
OPCUA_HOST_PORT=4840
DASHBOARD_HOST_PORT=8000

SIMULATION_TICK_SECONDS=0.25
COLLECTOR_PUBLISH_MS=500
COLLECTOR_SAMPLING_MS=250
COLLECTOR_SNAPSHOT_SECONDS=1.0
ANOMALY_BASELINE_SAMPLES=30
WEBSOCKET_POLL_SECONDS=0.5
LOG_LEVEL=INFO
